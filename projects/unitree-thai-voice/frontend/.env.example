# Server-side backend address; the browser uses the web app's own origin.
BACKEND_API_URL=http://127.0.0.1:8000
# Optional LAN hostnames/IP addresses used by a local HTTPS development proxy.
# DEV_ALLOWED_ORIGINS=192.168.0.23

# Optional: set only when intentionally using a separate public API origin.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
