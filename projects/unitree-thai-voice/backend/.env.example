# Replies: hybrid (prepared company/G1 answers + general AI), keywords, mock, openai, or ollama.
AI_PROVIDER=keywords
# In hybrid mode, general questions use local Ollama unless explicitly changed.
HYBRID_AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional for thinking-capable models such as Qwen3; false reduces latency.
# Leave unset to preserve the model's default behavior.
# OLLAMA_THINK=false

# TTS: edge, unitree, or off
TTS_PROVIDER=edge
EDGE_TTS_VOICE=th-TH-PremwadeeNeural

# Network/API
CORS_ORIGINS=http://localhost:3000

# Fast setup uses small. For Thai accuracy, run scripts/prepare_thai_stt.py,
# then use STT_MODEL=.runtime/models/whisper-th-medium-ct2 and STT_LANGUAGE=th.
# The Thai-tuned medium model is slower on CPU; compare with your actual mic.
# The selected model is downloaded on first use. Restart the API after changes.
STT_MODEL=small
# Prefer Thai; confidently English utterances remain English.
# th/en force one language; auto enables unrestricted language detection.
STT_LANGUAGE=thai_first
# Empty means no spelling hints. Only set a hint for a specific vocabulary need.
STT_INITIAL_PROMPT=
# Optional proper-name hints. Tested with the Thai model and the user's voice:
# STT_HOTWORDS=G1, ยูนิทรี, ออโต ไดแด็กติก
# Do not put answers or full questions here. Compare with your actual mic.
STT_HOTWORDS=
# CPU works without optional CUDA libraries. See README for the GPU profile.
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0

# Safety gate: leave false until network and the native TTS smoke test succeed.
ROBOT_AUDIO_ENABLED=false
ROBOT_INTERFACE=
ROBOT_BRIDGE_BIN=
ROBOT_SPEAKER_ID=0
